{
  "compilerOptions": {
    "target": "ESNext", "module": "Preserve", "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["bun"],
    "strict": true, "noUncheckedIndexedAccess": false, "noImplicitOverride": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "suite", "test"],
  "exclude": ["test/fixtures"]
}
